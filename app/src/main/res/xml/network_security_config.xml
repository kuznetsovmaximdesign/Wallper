<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!--
      Apple's Aerials CDN (sylvan.apple.com) serves a chain that ends in "Apple Root CA",
      which is not part of the Android system store. Trust that public root (bundled,
      SHA-256 B0:B1:73:0E:CB:C7:FF:45:05:14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24)
      for this host only; verification and hostname checks stay fully enabled.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
