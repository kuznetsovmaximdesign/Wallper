<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!--
      Apple's Aerials CDN (sylvan.apple.com) omits its intermediate certificate.
      AiaTrustManager completes the chain by downloading the issuer from the URL in the
      leaf's Authority Information Access extension. Those URLs are plain HTTP by design
      (RFC 5280 §4.2.2.1); the downloaded certificate is authenticated by its signature
      against the system roots, so cleartext is allowed only for Apple's cert host.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">certs.apple.com</domain>
    </domain-config>
</network-security-config>
